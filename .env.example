# Copy to .env (never commit .env). Empty values = provider unavailable state.
RAILMIND_PROVIDER=none            # none | railradar | rapidapi_irctc
RAILMIND_PROVIDER_API_KEY=
RAILMIND_PROVIDER_HOST=api.railradar.in
RAILMIND_PROVIDER_STATUS_PATH=/api/v1/liveTrainStatus
RAILMIND_MIN_REFRESH_SECONDS=120
RAILMIND_MAX_CALLS_PER_MINUTE=5
RAILMIND_MAX_CALLS_PER_DAY=20
RAILMIND_STALE_AFTER_SECONDS=900
